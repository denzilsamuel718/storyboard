# Shared
NODE_ENV=development

# API / Render
PORT=4000
# Optional locally (embedded SQLite is used automatically). Required on Render.
DATABASE_URL=
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=http://localhost:3000,http://localhost:3100
COOKIE_DOMAIN=
# Local defaults are shown below. Set unique values in production.
ADMIN_EMAIL=admin@sb.com
ADMIN_PASSWORD=ChangeMe123!

# S3-compatible private storage (AWS S3, Cloudflare R2, etc.)
S3_REGION=auto
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SIGNED_URL_TTL_SECONDS=900

# Email provider (optional; development logs verification URLs)
RESEND_API_KEY=
EMAIL_FROM=Submissions <noreply@example.com>

# Local development only; ignored when production S3/R2 is configured.
LOCAL_STORAGE_PATH=.data/storage

# Web / Vercel (public by design)
NEXT_PUBLIC_API_URL=http://localhost:4000/api
# Set this to your Render API URL in Vercel, for example:
# NEXT_PUBLIC_API_URL=https://your-render-service.onrender.com/api
